generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PipelineType {
  PRODUCTION
}

enum StageFinalType {
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String?
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Pipeline {
  id       Int             @id @default(autoincrement())
  name     String          @unique
  type     PipelineType
  stages   PipelineStage[]
  projects Project[]
}

model PipelineStage {
  id               Int             @id @default(autoincrement())
  pipelineId       Int
  pipeline         Pipeline        @relation(fields: [pipelineId], references: [id])
  name             String
  order            Int
  isFinal          Boolean         @default(false)
  finalType        StageFinalType?
  currentProjects  Project[]       @relation("currentStage")
}

model Project {
  id             Int           @id @default(autoincrement())
  title          String
  pipelineId     Int
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id])
  currentStageId Int
  currentStage   PipelineStage @relation("currentStage", fields: [currentStageId], references: [id])
  odooPartnerId  String?
  odooQuoteId    String?
  odooQuoteName  String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
