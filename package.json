{
  "name": "vk-tooling",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @vk/web dev",
    "dev:api": "pnpm --filter @vk/api dev",
    "build": "pnpm --filter @vk/web build",
    "build:api": "pnpm --filter @vk/api build",
    "tsc": "pnpm --filter @vk/web build --noEmit",
    "lint": "pnpm -r lint",
    "studio": "pnpm --filter @vk/api exec prisma studio",
    "dev:all": "docker compose up -d postgres && concurrently -n postgres,api,web,studio -c blue,yellow,green,magenta \"docker compose logs -f postgres\" \"pnpm dev:api\" \"pnpm dev\" \"pnpm studio\""
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
