{
  "name": "vk-tooling",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @vk/web dev",
    "dev:api": "pnpm --filter @vk/api dev",
    "build": "pnpm --filter @vk/web build",
    "build:api": "pnpm --filter @vk/api build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "@prisma/client", "@prisma/engines", "prisma"]
  }
}
